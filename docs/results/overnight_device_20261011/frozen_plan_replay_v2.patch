+    /** Exact opt-in 96-request device-validation trace. This is not an online policy. */
+    fun validateFrozenRequests(scenario: String, requests: List<ArrivalEnergyContract.Request>) {
+        require(scenario == "frozen_plan_periodic96")
+        require(requests.size == 96 && requests.map { it.id }.toSet().size == 96)
+        requests.forEachIndexed { i, q ->
+            val urgent = i % 2 == 0
+            require(q.ordinal == i && q.offsetMs == 35_000L + i * 350L)
+            require(q.task == (if (urgent) "classification" else "detection"))
+            require(q.priority == (if (urgent) "urgent" else "normal"))
+            require(q.deadlineMs == (if (urgent) 1500L else 6000L))
+        }
+    }
 
