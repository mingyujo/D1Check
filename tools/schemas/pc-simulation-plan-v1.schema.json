{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PC 시뮬레이션 사전 계획 v1 (미완료 계약)",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "schema_version", "status", "research_question", "input_sha256", "configuration", "configuration_sha256", "policies_sha256", "input_audit_sha256", "execution_authorized", "actual_simulation_executed"],
  "properties": {
    "protocol": {"const": "pc-simulation-plan-v1"},
    "schema_version": {"const": 1},
    "status": {"const": "SIMULATION_PLAN_INCOMPLETE"},
    "research_question": {"type": "string", "minLength": 1},
    "input_sha256": {"$ref": "#/$defs/hash"},
    "configuration_sha256": {"$ref": "#/$defs/hash"},
    "policies_sha256": {"$ref": "#/$defs/hash"},
    "input_audit_sha256": {"$ref": "#/$defs/hash"},
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "common", "policies", "objective", "statistics", "random", "execution", "scenario_axes", "sensitivity", "unresolved"],
      "properties": {
        "version": {"const": "pc-simulation-plan-v1"},
        "common": {"type": "object"},
        "policies": {"type": "array", "minItems": 5, "maxItems": 5},
        "objective": {"type": "object"},
        "statistics": {"type": "object"},
        "random": {"type": "object", "required": ["master_seed"], "properties": {"master_seed": {"const": 2026092201}}},
        "execution": {"type": "object"},
        "scenario_axes": {"type": "object"},
        "sensitivity": {"type": "array"},
        "unresolved": {"type": "array", "minItems": 1}
      }
    },
    "execution_authorized": {"const": false},
    "actual_simulation_executed": {"const": false}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
