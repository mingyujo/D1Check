{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "session_id", "source_provenance_sha256", "manifest_sha256", "manifest", "events", "receipt", "terminal_outcome", "interpretation"],
  "properties": {
    "protocol": {"const": "joint-empirical-session-v1"},
    "session_id": {"type": "string"},
    "source_provenance_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest": {"type": "object"},
    "events": {"type": "array", "minItems": 1},
    "receipt": {"type": "object"},
    "terminal_outcome": {"enum": ["succeeded", "failed"]},
    "interpretation": {"const": "whole session; setup referenced once per runtime; no independent field sampling"}
  }
}
