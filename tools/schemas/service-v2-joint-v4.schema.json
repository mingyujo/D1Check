{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object", "additionalProperties":false,
  "required":["protocol","session_id","provenance_sha256","seed","samples","scope","service_model_approved"],
  "properties":{
    "protocol":{"const":"service-v2-joint-v4"},"session_id":{"type":"string"},
    "provenance_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"seed":{"type":"integer","minimum":0},
    "scope":{"const":"entire joint session; no independent setup/active mixing"},"service_model_approved":{"const":false},
    "samples":{"type":"array","minItems":1,"items":{
      "type":"object","required":["session_id","runtime_id","request_id","task","backend","setup_ns","active_service_ns","inference_ns","worker_occupancy_ns","queue_wait_ns","runtime_state","transition_after_setup","memory_admission","thermal_applicability","provenance_sha256","setup_scope","role"],
      "properties":{
        "session_id":{"type":"string"},"runtime_id":{"type":"string"},"request_id":{"type":"string"},
        "task":{"enum":["classification","detection"]},"backend":{"enum":["CPU","GPU"]},
        "setup_ns":{"type":"integer","minimum":0},"active_service_ns":{"type":"integer","minimum":0},
        "inference_ns":{"type":"integer","minimum":0},"worker_occupancy_ns":{"type":"integer","minimum":0},"queue_wait_ns":{"type":"integer","minimum":0},
        "runtime_state":{"type":"object","required":["origin","invocation","state","warm_qualified"],"properties":{
          "origin":{"enum":["initial_setup","transition_after_setup"]},"invocation":{"type":"integer","minimum":1},
          "state":{"enum":["cold_first","early_after_cold","warm","transition_after_setup"]},"warm_qualified":{"const":false}}},
        "memory_admission":{"const":"admit"},"thermal_applicability":{"const":[0]},
        "transition_after_setup":{"type":"object","required":["observed","reason"]},"provenance_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    }}
  }
}
