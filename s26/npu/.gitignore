# vendor binaries pulled from the phone (Samsung proprietary) — never commit
device/*.so
# Samsung ENN Delegate archive (license agreement required to extract)
artifacts/ENNDelegate_*.zip
artifacts/ENNDelegate_*/
# built LiteRT binaries (10 MB+, reproducible with tools/build_litert_samsung.sh; SHA in README.md)
artifacts/litert_samsung_arm64/*
!artifacts/litert_samsung_arm64/README.md
# AOT intermediates / built shim
artifacts/compiled_e9965/*_apply_plugin.tflite
artifacts/compiled_e9965/*.so
# original model copy used only for the CPU control run (already in benchmark-runner assets)
artifacts/mobilenet_v1_1.0_224.tflite
__pycache__/
!results/
!results/**
# full unfiltered logcat dumps contain SIM / eSIM profile lines - keep local only
results/G4_DIAG_NPU_*.txt
# AOT outputs and EfficientDet binaries (moved from the root .gitignore). The two MobileNet files
# under artifacts/compiled_e9965 were tracked locally until 2026-10-02 and removed from the
# local history before the first push (see s26/GIT_REWRITE_MAP_20261002.md). They stay on disk.
*_Samsung_E9965.tflite
*_apply_plugin.tflite
*efficientdet*.tflite
