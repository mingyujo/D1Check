<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Tasks' transitive transport must not grant network access to this offline probe. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <application>
        <activity android:name=".DecodeDiagnosticActivity" android:excludeFromRecents="true"
            android:exported="true" android:noHistory="true" android:process=":model_probe" />
        <activity
            android:name=".ModelProbeEntryActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:process=":model_probe" />
    </application>
</manifest>
